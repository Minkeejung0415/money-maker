# ── Data feeds ────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_av_key_here
FRED_API_KEY=your_fred_key_here

# ── Sports odds — The-Odds-API ────────────────────────────────────────────────
# Free tier at https://the-odds-api.com — 500 req/month
ODDS_API_KEY=your_odds_api_key_here

# ── Alpaca (stocks) ───────────────────────────────────────────────────────────
# Paper: https://paper-api.alpaca.markets  |  Live: https://api.alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Crypto exchange via ccxt ──────────────────────────────────────────────────
# exchange_name must be a valid ccxt id: binance, kraken, coinbase, etc.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=your_exchange_key_here
EXCHANGE_API_SECRET=your_exchange_secret_here

# ── Execution gate ────────────────────────────────────────────────────────────
# true  = orchestrator sends live orders to broker/exchange
# false = signal-only mode, no orders placed (safe default)
EXECUTION_ENABLED=false

# ── AWS S3 (optional) ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=alpha-terminal-data
